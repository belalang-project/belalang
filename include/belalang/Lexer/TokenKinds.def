#ifndef TOK
#define TOK(name)
#endif

#ifndef KW
#define KW(name, str) TOK(name)
#endif

TOK(Unknown)
TOK(EndOfFile)
TOK(Empty)
TOK(Ident)
TOK(LiteralInteger)
TOK(LiteralFloat)
TOK(LiteralString)
TOK(Assign)
TOK(AddAssign)
TOK(SubAssign)
TOK(MulAssign)
TOK(DivAssign)
TOK(ModAssign)
TOK(BitAndAssign)
TOK(BitOrAssign)
TOK(BitXorAssign)
TOK(ShiftLeftAssign)
TOK(ShiftRightAssign)
TOK(Add)
TOK(Sub)
TOK(Mul)
TOK(Div)
TOK(Mod)
TOK(Not)
TOK(And)
TOK(Or)
TOK(BitAnd)
TOK(BitOr)
TOK(BitXor)
TOK(ShiftLeft)
TOK(ShiftRight)
TOK(Eq)
TOK(Ne)
TOK(Lt)
TOK(Le)
TOK(Gt)
TOK(Ge)
TOK(LeftParen)
TOK(RightParen)
TOK(LeftBrace)
TOK(RightBrace)
TOK(LeftBracket)
TOK(RightBracket)
TOK(Dot)
TOK(Comma)
TOK(Semicolon)
TOK(Backslash)
TOK(Colon)

KW(Function, "fn")
KW(While, "while")
KW(KwBreak, "break")
KW(KwContinue, "continue")
KW(KwTrue, "true")
KW(KwFalse, "false")
KW(If, "if")
KW(Else, "else")
KW(Return, "return")
KW(Struct, "struct")
KW(Import, "import")

#undef KW
#undef TOK
