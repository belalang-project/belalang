load("@rules_rust//rust:defs.bzl", "rust_binary")
load("@rules_cc//cc:defs.bzl", "cc_binary")

package(default_visibility = ["//visibility:public"])

rust_binary(
    name = "belalang",
    srcs = ["belalang.rs"],
    deps = [
        "//bbuild",
        "//birgen",
        "//diag",
        "//ast",
        "//lexer",
        "//session",
        "@crates//:lexopt",
        "@crates//:anyhow",
    ],
    link_deps = [
        "//bir",
    ],
)

cc_binary(
    name = "belalang-cc",
    srcs = glob(["*.cpp", "*.h"]),
    deps = [
        "@muopt//:muopt",
        "//lib:Lexer",
        "//lib:Diag",
    ],
)
