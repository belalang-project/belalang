load("@rules_rust//rust:defs.bzl", "rust_binary")
load("@rules_cc//cc:defs.bzl", "cc_binary")

package(default_visibility = ["//visibility:public"])

cc_binary(
    name = "belalang",
    srcs = glob(["*.cpp", "*.h"]),
    deps = [
        "@muopt//:muopt",
        "//lib:Lexer",
        "//lib:AST",
        "//lib:Diag",
        "//lib:BIRGen",
        "//lib:LLVMGen",
        "//include:Version",
        "//lib:BIR",
    ],
)
