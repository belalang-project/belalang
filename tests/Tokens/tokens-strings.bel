"Hello, World"; "Test"
"こんにちは"; "🦗"
"\n\r\t\"\x41"

# RUN: %belalang build --emit=tokens %s | %FileCheck %s
# CHECK: LiteralString "Hello, World" <0..14>
# CHECK: Semicolon <14..15>
# CHECK: LiteralString "Test" <16..22>
# CHECK: LiteralString "こんにちは" <23..40>
# CHECK: Semicolon <40..41>
# CHECK: LiteralString "🦗" <42..48>
# CHECK: LiteralString "\n\r\t\"A" <49..63>
