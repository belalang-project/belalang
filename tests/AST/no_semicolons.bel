# RUN: %belalang build --emit ast %s | %FileCheck %s
name

int_var := 123
flo_var := 44.2
str_var := "Hello, World!"

return 5

# CHECK:      Program
# CHECK-NEXT:   ExprStmt
# CHECK-NEXT:     IdentifierExpr name
# CHECK-NEXT:   DeclStmt
# CHECK-NEXT:     VarDecl int_var
# CHECK-NEXT:       IntLitExpr 123
# CHECK-NEXT:   DeclStmt
# CHECK-NEXT:     VarDecl flo_var
# CHECK-NEXT:       FloatLitExpr 4.420000e+01
# CHECK-NEXT:   DeclStmt
# CHECK-NEXT:     VarDecl str_var
# CHECK-NEXT:       StringLitExpr "Hello, World!"
# CHECK-NEXT:   ReturnStmt
# CHECK-NEXT:     IntLitExpr 5
