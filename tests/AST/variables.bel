# RUN: %belalang build --emit ast %s | %FileCheck %s
int_var := 123;
flo_var := 44.2;
str_var := "Hello, World!";

int_var = 1;
flo_var = 1.4;
str_var = "Hello, Mom!";

explicit_ty: Int = 12
implicit_ty := 12

# CHECK:      Program
# CHECK-NEXT:   DeclStmt
# CHECK-NEXT:     VarDecl int_var
# CHECK-NEXT:       IntLitExpr 123
# CHECK-NEXT:   DeclStmt
# CHECK-NEXT:     VarDecl flo_var
# CHECK-NEXT:       FloatLitExpr 4.420000e+01
# CHECK-NEXT:   DeclStmt
# CHECK-NEXT:     VarDecl str_var
# CHECK-NEXT:       StringLitExpr "Hello, World!"
# CHECK-NEXT:   ExprStmt
# CHECK-NEXT:     VarExpr int_var Assign
# CHECK-NEXT:       IntLitExpr 1
# CHECK-NEXT:   ExprStmt
# CHECK-NEXT:     VarExpr flo_var Assign
# CHECK-NEXT:       FloatLitExpr 1.400000e+00
# CHECK-NEXT:   ExprStmt
# CHECK-NEXT:     VarExpr str_var Assign
# CHECK-NEXT:       StringLitExpr "Hello, Mom!"
# CHECK-NEXT:   DeclStmt
# CHECK-NEXT:     VarDecl explicit_ty Int
# CHECK-NEXT:       IntLitExpr 12
# CHECK-NEXT:   DeclStmt
# CHECK-NEXT:     VarDecl implicit_ty
# CHECK-NEXT:       IntLitExpr 12
