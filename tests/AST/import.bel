# RUN: %belalang build --emit ast %s | %FileCheck %s

import "core:math"
import "std:io"
import "foo:bar"

# CHECK:      Program
# CHECK-NEXT:   ImportStmt
# CHECK-NEXT:     StringLitExpr "core:math"
# CHECK-NEXT:   ImportStmt
# CHECK-NEXT:     StringLitExpr "std:io"
# CHECK-NEXT:   ImportStmt
# CHECK-NEXT:     StringLitExpr "foo:bar"
