# RUN: %belalang build --emit ast %s | %FileCheck %s
add := fn(x: Int, y: Int) {
    return x + y;
};

mul := fn(x: Int, y: Int) { x * y };

sub := fn(x: Int, y: Int): Int {
    return x - y
}

v := fn() {
  return
}

# CHECK:      Program
# CHECK-NEXT:   DeclStmt
# CHECK-NEXT:     VarDecl add
# CHECK-NEXT:       FunctionLitExpr
# CHECK-NEXT:         VarDecl x Int
# CHECK-NEXT:         VarDecl y Int
# CHECK-NEXT:         BlockExpr
# CHECK-NEXT:           ReturnStmt
# CHECK-NEXT:             InfixExpr Add
# CHECK-NEXT:               IdentifierExpr x
# CHECK-NEXT:               IdentifierExpr y
# CHECK-NEXT:   DeclStmt
# CHECK-NEXT:     VarDecl mul
# CHECK-NEXT:       FunctionLitExpr
# CHECK-NEXT:         VarDecl x Int
# CHECK-NEXT:         VarDecl y Int
# CHECK-NEXT:         BlockExpr
# CHECK-NEXT:           ExprStmt
# CHECK-NEXT:             InfixExpr Mul
# CHECK-NEXT:               IdentifierExpr x
# CHECK-NEXT:               IdentifierExpr y
# CHECK-NEXT:   DeclStmt
# CHECK-NEXT:     VarDecl sub
# CHECK-NEXT:       FunctionLitExpr -> Int
# CHECK-NEXT:         VarDecl x Int
# CHECK-NEXT:         VarDecl y Int
# CHECK-NEXT:         BlockExpr
# CHECK-NEXT:           ReturnStmt
# CHECK-NEXT:             InfixExpr Sub
# CHECK-NEXT:               IdentifierExpr x
# CHECK-NEXT:               IdentifierExpr y
# CHECK-NEXT:   DeclStmt
# CHECK-NEXT:     VarDecl v
# CHECK-NEXT:       FunctionLitExpr
# CHECK-NEXT:         BlockExpr
# CHECK-NEXT:           ReturnStmt
