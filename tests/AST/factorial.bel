# RUN: %belalang build --emit ast %s | %FileCheck %s
fact := fn(n: Int) {
  if (n < 2) {
    return 1;
  }
  
  return n * fact(n - 1);
};

# CHECK:      Program
# CHECK-NEXT:   DeclStmt
# CHECK-NEXT:     VarDecl fact
# CHECK-NEXT:       FunctionLitExpr
# CHECK-NEXT:         VarDecl n Int
# CHECK-NEXT:         BlockExpr
# CHECK-NEXT:           ExprStmt
# CHECK-NEXT:             IfExpr
# CHECK-NEXT:               InfixExpr Lt
# CHECK-NEXT:                 IdentifierExpr n
# CHECK-NEXT:                 IntLitExpr 2
# CHECK-NEXT:               BlockExpr
# CHECK-NEXT:                 ReturnStmt
# CHECK-NEXT:                   IntLitExpr 1
# CHECK-NEXT:           ReturnStmt
# CHECK-NEXT:             InfixExpr Mul
# CHECK-NEXT:               IdentifierExpr n
# CHECK-NEXT:               CallExpr
# CHECK-NEXT:                 IdentifierExpr fact
# CHECK-NEXT:                 InfixExpr Sub
# CHECK-NEXT:                   IdentifierExpr n
# CHECK-NEXT:                   IntLitExpr 1
