# RUN: %belalang build --emit ast %s | %FileCheck %s
add(1, 2 * 3, 4 + 5);
fn(x: Int, y: Int) { x + y }(2, 3);

# CHECK:      Program
# CHECK-NEXT:   ExprStmt
# CHECK-NEXT:     CallExpr
# CHECK-NEXT:       IdentifierExpr add
# CHECK-NEXT:       IntLitExpr 1
# CHECK-NEXT:       InfixExpr Mul
# CHECK-NEXT:         IntLitExpr 2
# CHECK-NEXT:         IntLitExpr 3
# CHECK-NEXT:       InfixExpr Add
# CHECK-NEXT:         IntLitExpr 4
# CHECK-NEXT:         IntLitExpr 5
# CHECK-NEXT:   ExprStmt
# CHECK-NEXT:     CallExpr
# CHECK-NEXT:       FunctionLitExpr
# CHECK-NEXT:         VarDecl x Int
# CHECK-NEXT:         VarDecl y Int
# CHECK-NEXT:         BlockExpr
# CHECK-NEXT:           ExprStmt
# CHECK-NEXT:             InfixExpr Add
# CHECK-NEXT:               IdentifierExpr x
# CHECK-NEXT:               IdentifierExpr y
# CHECK-NEXT:       IntLitExpr 2
# CHECK-NEXT:       IntLitExpr 3
