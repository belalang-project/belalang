# RUN: %belalang build --emit ast %s | %FileCheck %s
struct Point {
  x: Int
  y: Int
}

p := Point { x = 12, y = 23 };

if (Point { x = 12, y = 23 }) == p {}

# CHECK:      Program
# CHECK-NEXT:   DeclStmt
# CHECK-NEXT:     StructDecl Point
# CHECK-NEXT:       VarDecl x Int
# CHECK-NEXT:       VarDecl y Int
# CHECK-NEXT:   DeclStmt
# CHECK-NEXT:     VarDecl p
# CHECK-NEXT:       StructLiteralExpr Point
# CHECK-NEXT:         VarExpr x Assign
# CHECK-NEXT:           IntLitExpr 12
# CHECK-NEXT:         VarExpr y Assign
# CHECK-NEXT:           IntLitExpr 23
# CHECK-NEXT:   ExprStmt
# CHECK-NEXT:     IfExpr
# CHECK-NEXT:       InfixExpr Eq
# CHECK-NEXT:         StructLiteralExpr Point
# CHECK-NEXT:           VarExpr x Assign
# CHECK-NEXT:             IntLitExpr 12
# CHECK-NEXT:           VarExpr y Assign
# CHECK-NEXT:             IntLitExpr 23
# CHECK-NEXT:         IdentifierExpr p
# CHECK-NEXT:       BlockExpr
