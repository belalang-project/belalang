# RUN: %belalang build --emit ast %s | %FileCheck %s
struct A {
  x: Int
  y: Int
}

struct B {}

struct C {
  x: String
}

# CHECK:      Program
# CHECK-NEXT:   DeclStmt
# CHECK-NEXT:     StructDecl A
# CHECK-NEXT:       VarDecl x Int
# CHECK-NEXT:       VarDecl y Int
# CHECK-NEXT:   DeclStmt
# CHECK-NEXT:     StructDecl B
# CHECK-NEXT:   DeclStmt
# CHECK-NEXT:     StructDecl C
# CHECK-NEXT:       VarDecl x String
