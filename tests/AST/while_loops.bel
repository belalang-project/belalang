# RUN: %belalang build --emit ast %s | %FileCheck %s
i := 0;
while i < 10 {
  i = i + 1;
}

# CHECK:      Program
# CHECK-NEXT:   DeclStmt
# CHECK-NEXT:     VarDecl i
# CHECK-NEXT:       IntLitExpr 0
# CHECK-NEXT:   WhileStmt
# CHECK-NEXT:     InfixExpr Lt
# CHECK-NEXT:       IdentifierExpr i
# CHECK-NEXT:       IntLitExpr 10
# CHECK-NEXT:     BlockExpr
# CHECK-NEXT:       ExprStmt
# CHECK-NEXT:         VarExpr i Assign
# CHECK-NEXT:           InfixExpr Add
# CHECK-NEXT:             IdentifierExpr i
# CHECK-NEXT:             IntLitExpr 1
