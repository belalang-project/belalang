# RUN: %belalang build --emit ast %s | %FileCheck %s

val := if true {
    1
} else {
    "hello"
}

# CHECK:      Program
# CHECK-NEXT:   DeclStmt
# CHECK-NEXT:     VarDecl val
# CHECK-NEXT:       IfExpr
# CHECK-NEXT:         BoolExpr true
# CHECK-NEXT:         BlockExpr
# CHECK-NEXT:           ExprStmt
# CHECK-NEXT:             IntLitExpr 1
# CHECK-NEXT:         BlockExpr
# CHECK-NEXT:           ExprStmt
# CHECK-NEXT:             StringLitExpr "hello"
