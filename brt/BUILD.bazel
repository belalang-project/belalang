load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "brt",
    srcs = ["src/brt.c"],
    linkstatic = True,
    deps = [
        "@bdwgc//:bdwgc",
    ],
)

genrule(
    name = "bdwgc",
    srcs = ["@bdwgc//:bdwgc"],
    outs = ["libbdwgc.a"],
    cmd = "cp $(location @bdwgc//:bdwgc) $(RULEDIR)/libbdwgc.a",
    visibility = ["//visibility:public"],
)
